# samconfig.toml.example
# Copy this file to samconfig.toml and fill in your values.
# DO NOT commit samconfig.toml — it contains account-specific settings.

version = 0.1

[default.build.parameters]
cached = true
parallel = true

[default.deploy.parameters]
stack_name        = "drainguard"
resolve_s3        = true          # SAM auto-creates a managed S3 bucket for artifacts
region            = "us-east-1"
confirm_changeset = false
capabilities      = "CAPABILITY_IAM"
parameter_overrides = [
  "Stage=prod",
  "AllowedOrigins=http://localhost:5173"  # Update after Amplify deploy
]
